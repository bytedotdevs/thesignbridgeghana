    "framer-motion": "^12.12.2",
    "lucide-react": "^0.475.0",
    "minisearch": "^7.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.6.3",
    "react-webcam": "^7.2.0",
    "three": "^0.177.0",
    "workbox-window": "^7.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
